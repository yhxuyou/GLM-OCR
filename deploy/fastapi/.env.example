# GLM-OCR FastAPI服务配置示例
# 复制此文件为 .env 并根据需要修改

# 基础配置
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# CORS配置
CORS_ORIGINS=["*"]

# 文件上传配置
MAX_UPLOAD_SIZE=52428800  # 50MB
ALLOWED_EXTENSIONS=["jpg", "jpeg", "png", "bmp", "pdf"]

# 任务队列配置
MAX_QUEUE_SIZE=1000
MAX_CONCURRENT_TASKS=4
TASK_TIMEOUT=300  # 秒

# 速率限制配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60  # 秒

# GLM-OCR配置
GLMOCR_MODE=selfhosted  # 可选: selfhosted, maas
# GLMOCR_CONFIG_PATH=/path/to/config.yaml
# GLMOCR_API_KEY=your-api-key
# GLMOCR_API_URL=https://api.example.com
# GLMOCR_MODEL=your-model-name

# GPU配置
# CUDA_VISIBLE_DEVICES=0
